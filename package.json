{
  "name": "sitefleet",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "new-site": "node tools/new-site.mjs",
    "check-content": "node tools/check-content.mjs",
    "deploy": "bash infra/deploy.sh",
    "gen:caddy": "node tools/gen-caddy.mjs",
    "check": "node tools/check-content.mjs && node tools/gen-caddy.mjs --check",
    "start": "turbo run start"
  },
  "devDependencies": {
    "turbo": "2.11.3",
    "typescript": "7.0.2",
    "prettier": "3.9.8",
    "gray-matter": "4.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
